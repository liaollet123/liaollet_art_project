# 이 파일을 .env.local 로 복사해서 값을 채운다. .env.local 은 git에 올라가지 않는다.
# 아무 값도 없어도 앱은 돌아간다: LLM 없이 키워드 방식, 저장은 .data/attic.json 파일.

# ---------------------------------------------------------------------------
# LLM (LangGraph 그래프가 부른다: lib/server/graphs.js)
# ---------------------------------------------------------------------------
# gemini | off  (비워 두면 키가 있을 때 gemini)
LLM_PROVIDER=

# Gemini — LangChain ChatGoogleGenerativeAI 로 부른다.
# 반드시 결제가 등록된 유료 등급 키를 쓴다. 무료 등급은 보낸 데이터가 모델 개선에 쓰일 수 있어
# 동의서("AI 학습에는 쓰이지 않습니다")와 어긋난다.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# 응답을 기다리는 최대 시간(ms). 넘으면 대체 문장으로 넘어간다
LLM_TIMEOUT_MS=12000

# ---------------------------------------------------------------------------
# 이미지 생성 — 시선(LIA·OL·LET)의 화풍으로 작품 이미지를 새로 그린다(lib/styles.js 프롬프트)
# off(기본): 캔버스 콜라주가 시선마다 다른 색·질감·구도로 사진을 엮는다. 비용 없음
# gemini   : GEMINI_API_KEY 로 Gemini 이미지 모델을 부른다. 장당 비용과 수십 초의 대기가 생긴다
# ---------------------------------------------------------------------------
IMAGE_PROVIDER=off
IMAGE_MODEL=gemini-2.5-flash-image
IMAGE_TIMEOUT_MS=40000

# ---------------------------------------------------------------------------
# 한도 — 티켓 기준으로 센다(전시장 와이파이에서는 모두가 같은 IP라서)
# ---------------------------------------------------------------------------
# 한 사람이 하루에 남길 수 있는 작품 수. 아이디(서명)와 기기(서명된 쿠키) 양쪽으로 센다
WORKS_PER_DAY=3
ANALYZE_PER_TICKET=4
COMPOSE_PER_TICKET=4
IP_PER_10MIN=600
# 기기 쿠키 서명 키. 아무 긴 무작위 문자열(예: openssl rand -hex 32). 배포에서는 꼭 넣는다
DEVICE_SECRET=

# ---------------------------------------------------------------------------
# 저장소 — Supabase (전시 배포용). supabase/schema.sql 을 SQL Editor 에서 한 번 실행한다.
# 비워 두면 .data/attic.json 파일에 저장한다(내 컴퓨터 개발용, 서버가 여러 대면 쓰지 않는다)
# service role 키는 서버에서만 쓴다. NEXT_PUBLIC_ 을 붙이지 않는다.
# ---------------------------------------------------------------------------
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# 이미지 저장 — Cloudinary. 올린 사진과 콜라주를 여기에 올리고, 표에는 주소만 남긴다.
# 대시보드 > Settings > API Keys 에서 확인. 서버에서만 쓴다(NEXT_PUBLIC_ 을 붙이지 않는다).
# 비워 두면 이미지를 저장소에 그대로 넣는다(내 컴퓨터 개발용). 배포에서는 꼭 채운다.
# ---------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# 운영자 화면(/admin) 비밀번호. 비워 두면 운영자 화면이 꺼진다
ADMIN_TOKEN=
